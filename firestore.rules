rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPERS GLOBALES
    // Nota: FRC no permite `let`, `if`, `for`. Toda función es
    // una única expresión de retorno.
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function isOwner(uid) {
      return isSignedIn() && myUid() == uid;
    }

    // El ÚNICO admin neto es este correo. Sin excepciones.
    // No aceptamos token.admin ni custom claims.
    function isAdmin() {
      return isSignedIn()
          && request.auth.token.email == 'ivanalbertoperezramirez@gmail.com';
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }

    function isApprovedSeller(uid) {
      return userDoc(uid).role == 'seller'
          && userDoc(uid).sellerStatus == 'approved'
          && userDoc(uid).active == true;
    }

    function validPublicationStatusTransition(oldStatus, newStatus) {
      return oldStatus == newStatus
          || (oldStatus == 'active' && newStatus in ['sold', 'deleted'])
          || (oldStatus == 'sold'   && newStatus == 'deleted');
    }

    // ------------------------------------------------------------
    // FIX CRÍTICO: allowlist de campos que el dueño puede tocar
    // en su propio documento. Sustituye el patrón !hasAny() que
    // permitía añadir campos nuevos arbitrarios (trustScore, etc.).
    // ------------------------------------------------------------
    function ownerCanUpdateUser(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
                'username',
                'usernameNormalized',
                'avatarUrl',
                'sellerStatus',
                'updatedAt'
              ])
          && (
               !newData.diff(oldData).affectedKeys().hasAny(['sellerStatus'])
               ||
               (newData.sellerStatus == 'pending'
                && oldData.sellerStatus in ['none', 'rejected', 'needs_info'])
             );
    }

    // ------------------------------------------------------------
    // FIX CRÍTICO: allowlist de campos que el dueño puede tocar
    // en su perfil público. No puede escribir campos de negocio
    // (displayName, category, phone…), ni sellerApproved, ni uid.
    // ------------------------------------------------------------
    function ownerCanUpdatePublicProfile(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
                'username',
                'usernameNormalized',
                'usernamePrefixes',
                'avatarUrl'
              ]);
    }

    // Allowlist estricta de campos de solicitud de vendedor.
    function validSellerApplication(data) {
      return data.keys().hasOnly([
        'uid', 'sellerType', 'displayName', 'businessName', 'category',
        'description', 'phone', 'city', 'state', 'socialUrl', 'contactMethod',
        'termsAccepted', 'status', 'rejectionReason', 'adminNote',
        'submittedAt', 'updatedAt', 'reviewedAt', 'reviewedBy'
      ])
      && data.uid is string
      && data.sellerType in ['person', 'business']
      && data.contactMethod in ['phone', 'whatsapp']
      && data.displayName is string
      && data.displayName.size() >= 2
      && data.displayName.size() <= 100
      && data.status == 'pending';
    }

    // ------------------------------------------------------------
    // FIX CRÍTICO: validación del payload de recuperación.
    // Sin auth ni rate limit nativo, al menos filtramos el ruido
    // con un regex de email válido y allowlist de campos.
    // ------------------------------------------------------------
    function validRecoveryRequest(data) {
      return data.keys().hasOnly([
                'email', 'status', 'requestedAt', 'reviewedAt',
                'reviewedBy', 'emailSentAt', 'rejectionReason'
              ])
          && data.status == 'pending'
          && data.email is string
          && data.email.size() >= 5
          && data.email.size() <= 320
          && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    // ------------------------------------------------------------
    // FIX CRÍTICO: campos que un participante puede modificar
    // en una conversación. Evita falsificar lastMessageSenderId
    // o reescribir participantIds/status a algo arbitrario.
    // ------------------------------------------------------------
    function conversationUpdateAllowed(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly([
                'lastMessage',
                'lastMessageAt',
                'lastMessageSenderId',
                'lastMessageExpiresAt',
                'readAtBy',
                'updatedAt',
                'status'
              ])
          && newData.participantIds == oldData.participantIds
          && (
               !newData.diff(oldData).affectedKeys().hasAny(['lastMessageSenderId'])
               || newData.lastMessageSenderId == myUid()
             );
    }

    // ============================================================
    // USUARIOS
    // ============================================================
    match /usuarios/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.role == 'user'
            && request.resource.data.sellerStatus == 'none'
            && request.resource.data.active == true
            && request.resource.data.admin == false);

      allow update: if isAdmin()
        || (isOwner(uid)
            && ownerCanUpdateUser(resource.data, request.resource.data));

      allow delete: if isAdmin();

      // ---- Subcolección: siguiendo (vendedores seguidos) ----
      match /siguiendo/{sellerUid} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.sellerUid == sellerUid;
        allow delete: if isOwner(uid);
      }

      // ---- Subcolección: favoritos ----
      match /favoritos/{pubId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid)
                      && request.resource.data.publicationId == pubId;
        allow delete: if isOwner(uid);
      }

      // ============================================================
      // NEW · Subcolección: dispositivos (tokens FCM)
      // ------------------------------------------------------------
      // El cliente (dueño) registra y elimina sus propios tokens.
      // El backend (Admin SDK) los lee y limpia tokens inválidos.
      // Validamos que el token sea un string razonable para
      // impedir escrituras basura o inyecciones.
      // ============================================================
      match /dispositivos/{tokenId} {
        allow read:   if isOwner(uid);
        allow create, update: if isOwner(uid)
                              && request.resource.data.token is string
                              && request.resource.data.token.size() >= 40
                              && request.resource.data.token.size() <= 4096;
        allow delete: if isOwner(uid);
      }

      // ============================================================
      // NEW · Subcolección: notificaciones (persistentes, Sistema A)
      // ------------------------------------------------------------
      // Las crea EXCLUSIVAMENTE el backend con Admin SDK (bypassa
      // reglas). El cliente sólo puede:
      //   - leer las suyas,
      //   - marcarlas como leídas (read: true, readAt),
      //   - eliminarlas.
      // No puede crear ni modificar otros campos (title, body,
      // publicationId, idempotencyKey, etc.).
      // ============================================================
      match /notificaciones/{notifId} {
        allow read:   if isOwner(uid);
        allow create: if false;   // sólo Admin SDK
        allow update: if isOwner(uid)
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['read', 'readAt'])
                      && request.resource.data.read == true;
        allow delete: if isOwner(uid);
      }
    }

    // ============================================================
    // USERNAMES (índice único)
    // ============================================================
    match /usernames/{normalized} {
      allow read:   if true;
      allow create: if isSignedIn()
                    && request.resource.data.uid == myUid();
      allow update, delete: if isSignedIn()
                            && resource.data.uid == myUid();
    }

    // ============================================================
    // PERFILES PÚBLICOS
    // Read abierto por diseño: sólo contiene identidad pública.
    // ============================================================
    match /perfilesPublicos/{uid} {
      allow read: if true;

      allow create: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.uid == uid
            && request.resource.data.sellerApproved == false);

      allow update: if isAdmin()
        || (isOwner(uid)
            && ownerCanUpdatePublicProfile(resource.data, request.resource.data));

      allow delete: if isAdmin();
    }

    // ============================================================
    // PUBLICACIONES
    // ============================================================
    match /publicaciones/{pubId} {

      allow read: if
        resource.data.status in ['active', 'sold']
        || (isSignedIn() && resource.data.userId == myUid())
        || isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.userId == myUid()
        && request.resource.data.status == 'active'
        && isApprovedSeller(myUid());

      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.userId == myUid()
            && request.resource.data.userId == myUid()
            && validPublicationStatusTransition(
                 resource.data.status,
                 request.resource.data.status));

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == myUid());
    }

    // ============================================================
    // SOLICITUDES DE VENDEDOR
    // Allowlist estricta para impedir inyección de campos.
    // ============================================================
    match /solicitudesVendedor/{uid} {

      allow read: if isOwner(uid) || isAdmin();

      allow create, update: if isAdmin()
        || (isOwner(uid) && validSellerApplication(request.resource.data));

      allow delete: if isAdmin();
    }

    // ============================================================
    // SOLICITUDES DE RECUPERACIÓN DE CONTRASEÑA
    // ============================================================
    match /solicitudesRecuperacion/{docId} {

      allow create: if validRecoveryRequest(request.resource.data);

      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // CONVERSACIONES + MENSAJES
    // ============================================================
    match /conversaciones/{convId} {

      function isParticipantOf(res) {
        return isSignedIn()
            && res != null
            && myUid() in res.data.participantIds;
      }

      allow read: if isParticipantOf(resource);

      allow create: if isSignedIn()
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 2
        && myUid() in request.resource.data.participantIds
        && request.resource.data.status == 'active';

      // FIX CRÍTICO: allowlist de campos + participantIds inmutables
      // + lastMessageSenderId solo si es el propio uid.
      allow update: if isParticipantOf(resource)
        && conversationUpdateAllowed(resource.data, request.resource.data);

      allow delete: if isAdmin();

      // ---- Mensajes ----
      match /mensajes/{msgId} {

        function canAccessConv() {
          return isSignedIn()
            && myUid() in get(/databases/$(database)/documents/conversaciones/$(convId))
                 .data.participantIds;
        }

        allow read: if canAccessConv();

        allow create: if canAccessConv()
          && request.resource.data.senderId == myUid();

        // Branch A: sender edita / soft-deletea su mensaje.
        // Branch B: cualquier participante "elimina para mí".
        allow update: if canAccessConv()
          && (
               (resource.data.senderId == myUid()
                && request.resource.data.senderId == resource.data.senderId
                && request.resource.data.createdAt == resource.data.createdAt)
               ||
               (request.resource.data.diff(resource.data)
                    .affectedKeys().hasOnly(['hiddenFor']))
             );

        allow delete: if isAdmin()
                      || (canAccessConv()
                          && resource.data.expiresAt <= request.time);
      }
    }

    // ============================================================
    // NEW · COLA DE NOTIFICACIONES (fallback de envío)
    // ------------------------------------------------------------
    // Si el POST del cliente a /api/notify-* falla (red, cierre
    // de pestaña…), el cliente encola el evento aquí. El cron de
    // Vercel lo reprocesa. Los eventos SOLO los puede leer/mutar
    // el admin (vía Admin SDK, que además bypassa las reglas).
    // ============================================================
    match /colaNotificaciones/{docId} {

      allow create: if isSignedIn()
                    && request.resource.data.uid == myUid()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.attempts == 0;

      allow read, update, delete: if isAdmin();
    }
  }
}